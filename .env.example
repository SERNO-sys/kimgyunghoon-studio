# Application
NODE_ENV=development

# Required: Session signing secret (at least 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# Required: Google OAuth credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: Google Gemini API key for AI Writer
# Create at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: GitHub integration for content sync
# Create a fine-grained personal access token with contents write permission
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_site_repository
GITHUB_BRANCH=main

# Optional: Cloudflare Pages deployment
# Create a Cloudflare API token with Cloudflare Pages:Edit permission
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_PROJECT_NAME=your_cloudflare_pages_project_name
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
