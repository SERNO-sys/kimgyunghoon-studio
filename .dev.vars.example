# Local development environment variables for Wrangler Pages dev.
# Copy this file to .dev.vars and fill in real values.
# .dev.vars is ignored by git and never uploaded to Cloudflare.

NODE_ENV=development
NEXTAUTH_URL=http://localhost:8788
GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth/callback/google

SESSION_SECRET=change-me-to-a-32-char-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key

R2_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com/your-bucket-name
